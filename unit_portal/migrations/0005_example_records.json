  "notices": [
    {"id": 1, "title": "[필독] 하반기 정보보안 교육 이수 안내", "body": "전 임직원은 이번 달 말까지 온라인 정보보안 교육을 이수해 주세요.\n\n- 대상: 전 임직원\n- 방법: 사내 학습 포털 접속 후 '2차 정보보안 교육' 수강\n- 소요 시간: 약 40분\n\n미이수 시 다음 달 사내 시스템 접근이 일부 제한될 수 있습니다.", "author_id": 7, "pinned": 1, "created": "2026-11-15 09:30"},
    {"id": 2, "title": "사옥 주차장 정기 점검에 따른 이용 제한", "body": "이번 주 토요일 09:00~15:00 지하 2층 주차장 소방 설비 점검이 진행됩니다.\n해당 시간에는 지하 1층을 이용해 주세요.", "author_id": 1, "pinned": 0, "created": "2026-11-14 14:10"},
    {"id": 3, "title": "연말 정산 서류 제출 일정", "body": "연말 정산 관련 서류는 다음 달 둘째 주 금요일까지 경영지원팀으로 제출해 주세요.\n세부 양식은 게시판 '정보공유'에 올려 두었습니다.", "author_id": 12, "pinned": 0, "created": "2026-11-12 11:00"},
    {"id": 4, "title": "신규 입사자 소개 (디자인팀 한수아 님)", "body": "디자인팀에 한수아 님이 합류했습니다. 따뜻하게 맞아 주세요!", "author_id": 9, "pinned": 0, "created": "2026-11-10 10:05"},
    {"id": 5, "title": "사내 메신저 정기 업데이트 안내", "body": "수요일 22:00~23:00 사내 메신저 서버 업데이트가 예정되어 있습니다.\n해당 시간에는 접속이 끊길 수 있습니다.", "author_id": 8, "pinned": 0, "created": "2026-11-07 17:40"}
  ],
  "posts": [
    {"id": 1, "category": "자유", "title": "점심 맛집 추천 받습니다", "body": "회사 근처에 새로 생긴 곳 있으면 알려주세요. 국밥 빼고요...", "author_id": 11, "views": 34, "created": "2026-11-16 11:20"},
    {"id": 2, "category": "질문", "title": "VPN 접속이 자꾸 끊기는데 저만 그런가요?", "body": "재택 근무 중인데 30분마다 연결이 끊깁니다. 해결하신 분 계신가요?", "author_id": 4, "views": 58, "created": "2026-11-15 16:02"},
    {"id": 3, "category": "정보공유", "title": "코드 리뷰 체크리스트 공유합니다", "body": "개발1팀에서 쓰는 리뷰 체크리스트입니다.\n\n1. 입력값 검증이 서버에서 이뤄지는가\n2. 쿼리는 모두 바인딩 변수를 쓰는가\n3. 비밀 값이 코드에 들어가 있지 않은가\n4. 에러 메시지에 내부 정보가 노출되지 않는가", "author_id": 3, "views": 121, "created": "2026-11-14 09:48"},
    {"id": 4, "category": "경조사", "title": "영업팀 강현우 팀장님 득녀 소식", "body": "축하드립니다! 산모와 아기 모두 건강하다고 합니다.", "author_id": 9, "views": 87, "created": "2026-11-13 13:15"},
    {"id": 5, "category": "자유", "title": "사내 풋살 동호회 인원 모집", "body": "매주 목요일 저녁 7시, 회사 옆 풋살장입니다. 초보 환영!", "author_id": 8, "views": 45, "created": "2026-11-11 18:30"},
    {"id": 6, "category": "정보공유", "title": "연말 정산 양식 모음", "body": "경영지원팀에서 안내한 양식 목록입니다. 필요한 서류를 미리 챙겨 두세요.", "author_id": 12, "views": 203, "created": "2026-11-12 11:30"},
    {"id": 7, "category": "질문", "title": "회의실 예약은 어디서 하나요?", "body": "입사한 지 얼마 안 돼서요. 일정 메뉴에 등록하면 되는 건가요?", "author_id": 6, "views": 29, "created": "2026-11-10 10:40"},
    {"id": 8, "category": "자유", "title": "3층 커피머신 원두 바뀌었네요", "body": "산미가 좀 있는 걸로 바뀐 것 같은데 저는 좋습니다.", "author_id": 5, "views": 61, "created": "2026-11-09 15:22"},
    {"id": 9, "category": "정보공유", "title": "피싱 메일 구별법 정리", "body": "보안팀에서 정리한 내용입니다.\n\n- 발신 주소의 도메인을 끝까지 확인\n- 급하게 클릭을 유도하는 문구 주의\n- 첨부 파일의 확장자 확인\n- 의심되면 보안팀(내선 207)으로 신고", "author_id": 7, "views": 176, "created": "2026-11-08 09:10"},
    {"id": 10, "category": "자유", "title": "다음 달 워크숍 장소 투표", "body": "강릉 vs 제주, 댓글로 의견 남겨 주세요.", "author_id": 1, "views": 142, "created": "2026-11-06 14:00"},
    {"id": 11, "category": "질문", "title": "법인카드 영수증 분실했을 때", "body": "재발급이 안 되는 가게인데 어떻게 처리하면 될까요?", "author_id": 11, "views": 38, "created": "2026-11-05 17:05"},
    {"id": 12, "category": "자유", "title": "퇴근길 지하철 연착 공유", "body": "2호선 신호 장애로 15분 정도 지연 중입니다.", "author_id": 2, "views": 22, "created": "2026-11-04 18:45"}
